# MySQL connection (also used by Alembic; alembic.ini holds no credentials)
DATABASE_URL = "mysql+pymysql://user:password@host:3306/db-name"

# JWT auth. Use a long random secret, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
# (the variable name ALOGORITHM is spelled this way in the code)
ALOGORITHM = "HS256"
ACCESS_TOKEN_EXPIRY = 60
JWT_SECRET_KEY = ""

# AI coach (optional). Any OpenAI-compatible Chat Completions endpoint that supports tool calling.
# OpenAI: leave AI_BASE_URL empty, set AI_API_KEY to your OpenAI key and AI_MODEL to e.g. gpt-5-mini.
# Groq (free tier): AI_BASE_URL = "https://api.groq.com/openai/v1", AI_MODEL = "openai/gpt-oss-120b".
# Without AI_API_KEY, /chat returns 503 and every other endpoint works normally.
AI_BASE_URL = ""
AI_API_KEY = ""
AI_MODEL = "gpt-5-mini"
